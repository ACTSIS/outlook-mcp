# Microsoft Azure App Registration Credentials
# Get these from Azure Portal > App Registrations > Your App

# Application (client) ID from Azure Portal
MS_CLIENT_ID=your-client-id-here

# Client secret VALUE (not the secret ID) from Azure Portal > Certificates & secrets
MS_CLIENT_SECRET=your-client-secret-here

# Directory (tenant) ID from Azure Portal > Microsoft Entra ID > Overview
# For single-tenant apps, set this to your tenant GUID so /common is not used.
MS_TENANT_ID=your-tenant-id-here

# Optional identity-platform override used by the runtime and auth server.
# MS_AUTHORITY_HOST=https://login.microsoftonline.com

# Advanced TokenStorage overrides. The standalone auth server does not apply these
# consistently during initial acquisition; read docs/authentication.md before using them.
# MS_SCOPES=offline_access User.Read Mail.Read Mail.ReadWrite Mail.Send Calendars.Read Calendars.ReadWrite Contacts.Read Files.Read Files.ReadWrite
# MS_REDIRECT_URI=http://localhost:3333/auth/callback
# MS_TOKEN_ENDPOINT=https://login.microsoftonline.com/your-tenant-id-here/oauth2/v2.0/token

# Optional: Enable test mode with mock data (true/false)
USE_TEST_MODE=false

# Optional intranet HashiCorp Vault runtime configuration.
# Set VAULT_ADDR to enable Vault OIDC/JWT authentication and KV v2 loading.
# Developers need network access to this address through the corporate network,
# VPN, or NetBird as required by their environment.
# Actsis example: set these explicitly when using the corporate Vault.
# VAULT_ADDR=https://vault.edge.actsis.com
# VAULT_AUTH_MOUNT=oidc
# VAULT_ROLE=outlook-mcp-developer
# VAULT_OIDC_PORT=8250
# VAULT_KV_MOUNT=kv
# VAULT_SECRET_PATH=apps/outlook-mcp/prod
# VAULT_NAMESPACE=team/example
# VAULT_SKIP_BROWSER=false
# VAULT_CUSTOM_HEADER_NAME=X-ACCESS-TOKEN
# The custom header value is sensitive. Replace this placeholder locally
# through the process environment, OpenCode secret configuration, or this
# protected local .env file. Never commit or embed the real value.
# VAULT_CUSTOM_HEADER_VALUE=replace-with-local-secret
# VAULT_TOKEN is intentionally not included: use it only for automation/testing,
# never as a recommended developer-install configuration.
