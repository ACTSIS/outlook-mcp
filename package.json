{
  "name": "m365-mcp",
  "version": "2.2.0",
  "description": "MCP server for Microsoft 365 mail, calendar, OneDrive, inbox rules, and Power Automate",
  "main": "index.js",
  "bin": {
    "m365-mcp": "./index.js",
    "m365-mcp-auth": "./outlook-auth-server.js"
  },
  "scripts": {
    "start": "node bin/m365-mcp.js",
    "auth-server": "node bin/m365-mcp.js auth",
    "test-mode": "USE_TEST_MODE=true node bin/m365-mcp.js",
    "inspect": "npx @modelcontextprotocol/inspector node bin/m365-mcp.js",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "node build/package.js",
    "prepare": "husky"
  },
  "keywords": [
    "claude",
    "outlook",
    "onedrive",
    "power-automate",
    "microsoft-365",
    "mcp",
    "microsoft-graph",
    "email",
    "fork",
    "subfolder",
    "folder-resolution"
  ],
  "author": "Ricardo Pinto <rafaga2469@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^16.5.0",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/inspector": "^0.22.0",
    "@vercel/ncc": "0.45.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.2.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.{js,json,md}": "prettier --write"
  },
  "overrides": {
    "sanitize-html": {
      "htmlparser2": "8.0.2"
    }
  }
}
